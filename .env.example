# =====================================================================
# SocialGrow - Environment Variables Configuration
# Copy this file to .env and adjust the values for your environment.
# =====================================================================

# Django Core
SECRET_KEY=django-insecure-change-this-in-production-random-key-here
DEBUG=False
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Engine: 'sqlite3' (default for quick run) or 'mysql' (production)
DB_ENGINE=sqlite3

# MySQL Configuration (only needed if DB_ENGINE=mysql)
DB_NAME=socialgrow
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# SMS Provider Configuration (SmsIr / IPPanel)
SMS_API_KEY=your_sms_api_key_here
SMS_TEMPLATE_OTP=559599
SMS_TEMPLATE_NOTIFY=755099
ADMIN_PHONE=09120000000

# Payment Gateways
ZARINPAL_MERCHANT=your_zarinpal_merchant_id_here
ZIBAL_MERCHANT=zibal
SIZPAY_MERCHANT=your_sizpay_merchant_id_here

# Google reCAPTCHA
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Telegram Live Chat Notifications (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here
